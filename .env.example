# Copie para .env e preencha com os dados do seu projeto Neon.
# O jeito mais simples é rodar `neon deploy` no projeto: ele cria/atualiza
# o Postgres, habilita o Neon Auth e grava estas variáveis automaticamente.

# Servidor
PORT=3000
NODE_ENV=development

# Neon Postgres (painel do projeto > Connect, ou `neon env pull`)
# Use a URL com -pooler para o tráfego da API e a URL direta para DDL/migrações.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Neon Auth (painel do projeto > Auth, ou `neon deploy`)
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Opcional: chave pública JWKS, caso você valide tokens JWT diretamente.
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Neon Object Storage (gerado por `neon deploy`)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=aws-us-east-2
FLUXO_BACKUP_BUCKET=fluxo-backups

# Neon Functions (gerado por `neon deploy`)
NEON_FUNCTION_FLUXOSTATUS_BASE_URL=https://<branch>-fluxostatus.compute.<regiao>.aws.neon.tech/
# Segredo compartilhado entre a API e a função fluxostatus.
# Gere um valor longo e aleatório; não use o exemplo.
FLUXO_FUNCTION_KEY=troque-por-um-segredo-longo-e-aleatorio

# Neon Realtime (gerado por `neon deploy`)
NEON_REALTIME_URL=wss://<branch>.rt.<regiao>.aws.neon.tech/
NEON_REALTIME_SECRET=
# Usado apenas na avaliação do neon.ts durante `neon deploy`.
NEON_REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3210,http://localhost:3212

# Neon AI Gateway (exige plano pago Launch/Scale + créditos)
# Enquanto o projeto estiver no Free, o app responde 503 com uma mensagem clara.
# NEON_AI_GATEWAY_BASE_URL=https://<branch>.ai.<regiao>.aws.neon.tech/
# NEON_AI_GATEWAY_TOKEN=
# NEON_AI_MODEL=gpt-5-mini

# Opcional: restrinja as origens que podem chamar a API.
# Sem valor, a API aceita a mesma origem e o app aberto via file://.
# CORS_ORIGIN=https://seu-app.onrender.com

# Opcional: tamanho do pool de conexões Postgres (padrão 5).
# DB_POOL_SIZE=5
