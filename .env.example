# Copie para .env e preencha com os dados do seu cluster TiDB Cloud.
# No Render, configure estas mesmas variáveis em Environment.

# Servidor
PORT=3000
NODE_ENV=development

# TiDB Cloud (painel do cluster > Connect)
DB_HOST=gateway01.xxxxxxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=sua-senha
DB_NAME=fluxo
DB_SSL=true
# Opcional: CA em PEM (com quebras de linha escapadas como \n)
# DB_SSL_CA=
# Não recomendado em produção; use somente para diagnóstico local.
# DB_SSL_REJECT_UNAUTHORIZED=false

# Segurança
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres

# Opcional: restrinja as origens que podem chamar a API.
# Sem valor, a API aceita a mesma origem e o app aberto via file://.
# CORS_ORIGIN=https://seu-app.onrender.com
